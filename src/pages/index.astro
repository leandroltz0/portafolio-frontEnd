---
import Layout from '../layouts/Layout.astro';
import Cursor from '../components/react/Cursor';
import GrainOverlay from '../components/react/GrainOverlay';
import Navbar from '../components/react/Navbar';
import Hero from '../components/react/Hero';
import About from '../components/react/About';
import Experience from '../components/react/Experience';
import Projects from '../components/react/Projects';
import Skills from '../components/react/Skills';
import Education from '../components/react/Education';
import Contact from '../components/react/Contact';
---

<Layout>
  <Cursor client:load />
  <GrainOverlay client:load />
  <Navbar client:load />
  <main>
    <Hero client:load />
    <About client:load />
    <Experience client:load />
    <Projects client:load />
    <Skills client:load />
    <Education client:load />
    <Contact client:load />
  </main>
  <footer class="text-center py-8 px-[clamp(20px,5vw,80px)] border-t border-border text-[11px] text-muted-foreground tracking-[0.08em]">
    &copy; 2026 Leandro Maciel
  </footer>
</Layout>
