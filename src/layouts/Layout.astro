---
import '../styles/globals.css';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Leandro Maciel — Full Stack Developer & UI Designer',
  description = 'Full Stack Developer & UI Designer from Argentina. I build complete digital products — from design to server.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/logo.png" />

    <!-- Google Fonts: DM Serif Display (heading), Plus Jakarta Sans (body), JetBrains Mono (mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --font-display: 'DM Serif Display', serif;
        --font-body: 'Plus Jakarta Sans', sans-serif;
        --font-mono: 'JetBrains Mono', monospace;
      }
    </style>
  </head>
  <body class="min-h-screen bg-background text-foreground font-sans antialiased">
    <slot />
  </body>
</html>
